# VIP API local secrets — copy to services/api/.env (gitignored).
# Do not put these in orchestr8/.env (that file is LLM keys only).

# Preferred: eBay developer Production keyset (App ID + Cert ID).
# The API mints a public-data application token and refreshes it.
# https://developer.ebay.com/my/keys
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_ENVIRONMENT=production

# Client-credentials scope. Default is public data (api_scope) — that is what
# Production client-credentials lists actually grant. If eBay later grants
# Browse, you can request it explicitly:
# EBAY_OAUTH_SCOPE=https://api.ebay.com/oauth/api_scope/buy.browse

# Optional override: paste a ready application token (expires ~2 hours).
# Leave blank when APP_ID + CERT_ID are set.
# EBAY_OAUTH_TOKEN=

# Optional aliases (same values as App ID / Cert ID):
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=

# Production keyset compliance — marketplace account deletion (public https).
# Token: 32–80 chars, letters/numbers/-/_ only. Never commit the real token.
# Endpoint URL must match the eBay portal field exactly (usually the Worker).
# EBAY_DELETION_VERIFICATION_TOKEN=
# EBAY_DELETION_ENDPOINT_URL=https://vip-ebay-deletion.YOUR_SUBDOMAIN.workers.dev

# Comics vault walk (plan 0003). Default cursor: .state/comics-comps-walk.json
# VIP_COMICS_COMPS_CURSOR=
# VIP_EBAY_RATE_LIMIT_MS=1000

# --- eBay Sell (Inventory / Fulfillment / Analytics) — user OAuth, not Browse ---
# Distinct from client-credentials comps above. Sandbox first.
# EBAY_ENV is the sell engine's own switch. Only EBAY_ENV=production publishes
# to real eBay; anything else (including unset) stays on Sandbox, and the
# EBAY_ENVIRONMENT above does not affect it. Each environment needs its own
# Connect, and its refresh token is stored per environment.
# EBAY_APP_ID / EBAY_CERT_ID are shared with the Browse comps above — there is
# only one pair. A keyset is valid on one host, so while EBAY_ENV=sandbox holds
# a Sandbox keyset here, Browse comps (EBAY_ENVIRONMENT=production) cannot mint
# a token. Moving the sell engine to Production puts both back on one keyset.
# EBAY_ENV=sandbox
# EBAY_MARKETPLACE_ID=EBAY_US
# EBAY_REDIRECT_URI=https://your-ru-name-from-ebay-developer-portal
# EBAY_MERCHANT_LOCATION_KEY=
# EBAY_PAYMENT_POLICY_ID=
# EBAY_RETURN_POLICY_ID=
# EBAY_FULFILLMENT_POLICY_ID=
# EBAY_HIGH_VALUE_USD=50
# EBAY_AUTO_PUBLISH_HIGH_VALUE=false
# Ship-from address for the Inventory API warehouse location publish creates on
# Sandbox when EBAY_MERCHANT_LOCATION_KEY does not resolve. Unset, these fall
# back to eBay's own sample address in New York — set them so the Sandbox
# listing shows your real ship-from and quotes real postage. Production never
# creates a location, so these are ignored there and the location named by
# EBAY_MERCHANT_LOCATION_KEY must already exist on the account.
# EBAY_LOCATION_LINE1=
# EBAY_LOCATION_CITY=
# EBAY_LOCATION_STATE=
# EBAY_LOCATION_POSTAL=
# EBAY_LOCATION_COUNTRY=US
# Leaf category per asset kind. An offer under a parent category fails to
# publish with eBay error #25005. The built-in defaults are the EBAY_US leaves
# (comic 259104, sports 261328, pokemon/mtg 183454); "other" has no default and
# must be set here before an "other" holding can publish. Sandbox trees lag
# Production, so if preflight's "Listing category" check fails it lists the
# real leaf IDs from your own tree — set the matching var to one of them.
# EBAY_CATEGORY_COMIC=
# EBAY_CATEGORY_SPORTS=
# EBAY_CATEGORY_POKEMON=
# EBAY_CATEGORY_MTG=
# EBAY_CATEGORY_OTHER=
# Optional sell-scope override (space-separated):
# EBAY_SELL_OAUTH_SCOPE=https://api.ebay.com/oauth/api_scope/sell.inventory
