  <Worksheet ss:Name="Pop red flags">
    <Table>
      <Row ss:StyleID="Header">
        <Cell><Data ss:Type="String">id</Data></Cell>
        <Cell><Data ss:Type="String">title</Data></Cell>
        <Cell><Data ss:Type="String">when</Data></Cell>
        <Cell><Data ss:Type="String">why</Data></Cell>
      </Row>
      <Row><Cell><Data ss:Type="String">high-pop</Data></Cell><Cell><Data ss:Type="String">High pop</Data></Cell><Cell><Data ss:Type="String">2,500+ at the grade you need (10k+ is automatic no).</Data></Cell><Cell><Data ss:Type="String">Buyers will wait for a nicer copy at the same number.</Data></Cell></Row><Row><Cell><Data ss:Type="String">thin-spread</Data></Cell><Cell><Data ss:Type="String">Thin 10 / 9 spread</Data></Cell><Cell><Data ss:Type="String">PSA/CGC 10 sells &lt;35% above the 9.</Data></Cell><Cell><Data ss:Type="String">The most common outcome (a 9) does not pay the ticket.</Data></Cell></Row><Row><Cell><Data ss:Type="String">modern-print</Data></Cell><Cell><Data ss:Type="String">Still-printing modern</Data></Cell><Cell><Data ss:Type="String">Set is &lt;4 years old and census is already climbing.</Data></Cell><Cell><Data ss:Type="String">You are racing the print run. Sell raw or wait for a crash.</Data></Cell></Row><Row><Cell><Data ss:Type="String">no-demand</Data></Cell><Cell><Data ss:Type="String">Low demand</Data></Cell><Cell><Data ss:Type="String">&lt;12 confirmed sales / year.</Data></Cell><Cell><Data ss:Type="String">A pretty slab that does not sell is inventory, not profit.</Data></Cell></Row>
    </Table>
  </Worksheet>
  <Worksheet ss:Name="Lanes">
    <Table>
      <Row><Cell><Data ss:Type="String">Dropdown presets</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">bulk</Data></Cell><Cell><Data ss:Type="String">Value Bulk / CGC Bulk / BGS Base — cheapest, slowest, often paused or min-qty.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">value</Data></Cell><Cell><Data ss:Type="String">PSA Standard/Priority, CGC Economy/Standard — default hobby lane.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">express</Data></Cell><Cell><Data ss:Type="String">PSA Express/Premier, CGC Express, BGS Express/Priority — only when the card already clears the fee 3×.</Data></Cell></Row>
    </Table>
  </Worksheet>
</Workbook>
