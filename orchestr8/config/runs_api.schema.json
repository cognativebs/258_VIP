{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orchestr8 Runs API contracts",
  "description": "Response shapes for GET /v1/runs and GET /v1/runs/:id (build spec orchestr8-runs-api).",
  "definitions": {
    "retrieved_at": {
      "type": "string",
      "description": "ISO-8601 timestamp when the API formed this response"
    },
    "question_truncated": {
      "type": "boolean",
      "description": "true when question was trimmed for the list view (limit 200 chars)"
    },
    "run_list_item": {
      "type": "object",
      "required": [
        "run_id",
        "task",
        "question",
        "question_truncated",
        "created_at",
        "retrieved_at"
      ],
      "properties": {
        "run_id": { "type": "string" },
        "task": { "type": ["string", "null"] },
        "mode": { "type": ["string", "null"] },
        "roles": { "type": "array", "items": { "type": "string" } },
        "question": { "type": "string", "maxLength": 200 },
        "question_truncated": { "$ref": "#/definitions/question_truncated" },
        "created_at": { "type": ["string", "null"] },
        "retrieved_at": { "$ref": "#/definitions/retrieved_at" },
        "costUsd": { "type": "number" },
        "vetoed": { "type": "boolean" },
        "verification": { "type": ["string", "null"] }
      },
      "not": {
        "anyOf": [
          { "required": ["trace"] },
          { "required": ["vote"] },
          { "required": ["final_text"] },
          { "required": ["steps"] }
        ]
      }
    },
    "run_list_response": {
      "type": "object",
      "required": ["runs", "count", "retrieved_at"],
      "properties": {
        "runs": {
          "type": "array",
          "items": { "$ref": "#/definitions/run_list_item" }
        },
        "count": { "type": "integer", "minimum": 0 },
        "retrieved_at": { "$ref": "#/definitions/retrieved_at" },
        "source": { "type": "string" }
      }
    },
    "run_detail_response": {
      "type": "object",
      "required": ["run_id", "retrieved_at", "question_truncated"],
      "properties": {
        "run_id": { "type": "string" },
        "retrieved_at": { "$ref": "#/definitions/retrieved_at" },
        "question_truncated": { "$ref": "#/definitions/question_truncated" },
        "question": { "type": "string" },
        "task": { "type": "string" },
        "trace": { "type": "array" },
        "provenance": { "type": "object" }
      }
    },
    "error_not_found": {
      "type": "object",
      "required": ["error", "run_id"],
      "properties": {
        "error": { "const": "not_found" },
        "run_id": { "type": "string" }
      }
    },
    "error_malformed_run": {
      "type": "object",
      "required": ["error", "run_id", "detail"],
      "properties": {
        "error": { "const": "malformed_run" },
        "run_id": { "type": "string" },
        "detail": { "type": "string" }
      }
    }
  }
}
