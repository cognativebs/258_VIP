{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orchestr8 Build Spec (Work Order)",
  "description": "ADR 0003 · O1 — critic-passed work order that a human executes in Cursor. Orchestr8 authors; Cursor builds.",
  "type": "object",
  "required": [
    "id",
    "title",
    "goal",
    "constraints",
    "contracts_first",
    "file_plan",
    "acceptance_tests",
    "risks",
    "cursor_prompt",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3,
      "description": "Stable slug, e.g. o2-diff-review"
    },
    "title": { "type": "string", "minLength": 5 },
    "goal": { "type": "string", "minLength": 20 },
    "constraints": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "contracts_first": {
      "type": "array",
      "description": "Types/schemas/contracts to define or update before implementation (AGENTS.md DoD).",
      "items": {
        "type": "object",
        "required": ["path", "change"],
        "properties": {
          "path": { "type": "string" },
          "change": { "type": "string" }
        }
      },
      "minItems": 1
    },
    "file_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "action", "notes"],
        "properties": {
          "path": { "type": "string" },
          "action": { "type": "string", "enum": ["create", "modify", "delete", "leave"] },
          "notes": { "type": "string" }
        }
      },
      "minItems": 1
    },
    "acceptance_tests": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "out_of_scope": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cursor_prompt": {
      "type": "string",
      "minLength": 40,
      "description": "Ready-to-paste prompt for Cursor. Must include goal, constraints, file plan, and acceptance tests."
    },
    "provenance": {
      "type": "object",
      "required": ["source", "method", "verification_status"],
      "properties": {
        "source": { "type": "string" },
        "method": { "type": "string" },
        "rule_or_model_version": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "verification_status": {
          "type": "string",
          "enum": ["unverified", "critic_passed", "critic_vetoed", "human_approved"]
        },
        "run_id": { "type": ["string", "null"] },
        "council": { "type": ["string", "null"] },
        "roles": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
