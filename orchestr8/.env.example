# Orchestr8 AI Gateway - provider chat keys (NOT admin/billing keys).
#
# Copy this file, then paste each key into the matching line:
#   copy orchestr8\.env.example orchestr8\.env     (Windows)
#   cp orchestr8/.env.example orchestr8/.env       (macOS / Linux)
#
# Keys are read from orchestr8/.env only. Never commit the filled-in file.
# At least one key is enough for /v1/health ok:true; agents on a missing
# provider fail that step instead of inventing an answer.
#
# --- Which key goes where (common mix-up) ---
# OPENAI_API_KEY     from https://platform.openai.com/api-keys
#                    looks like: sk-proj-...  or  sk-...
#                    does NOT start with sk-ant- or xai-
#
# ANTHROPIC_API_KEY  from https://console.anthropic.com/settings/keys
#                    looks like: sk-ant-api03-...
#                    does NOT go in OPENAI_API_KEY
#
# XAI_API_KEY        from https://console.x.ai/  (Grok)
#                    looks like: xai-...
#                    env name is XAI_API_KEY (not GROK_API_KEY; that alias works too)
#
# Optional admin/spend keys (accounts UI only - do not put chat keys here):
#   OPENAI_ADMIN_KEY=
#   ANTHROPIC_ADMIN_KEY=
#   XAI_MGMT_KEY=
#   XAI_TEAM_ID=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Optional: change the gateway port (collector face expects 5210).
# ORCHESTR8_PORT=5210
