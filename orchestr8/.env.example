# Orchestr8 AI Gateway — provider keys.
#
# Copy to orchestr8/.env and fill in at least one provider. The gateway reports
# ok:true on /v1/health as soon as one key is present; agents assigned to an
# unconfigured provider fail that step rather than silently answering.
#
#   copy orchestr8\.env.example orchestr8\.env     (Windows)
#   cp orchestr8/.env.example orchestr8/.env       (macOS / Linux)
#
# Keys are read from this file only — never commit the filled-in .env.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Optional: change the gateway port (collector face expects 5210).
# ORCHESTR8_PORT=5210
